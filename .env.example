# Arquivo de exemplo para variáveis de ambiente (pode ser commitado no GitHub)
# Copie este arquivo para .env e preencha com as credenciais reais.

# Credenciais dos Usuários (authService.js)
VITE_USER_PAI_EMAIL=seu_email_pai@dominio.com
VITE_USER_PAI_PASSWORD=sua_senha_aqui
VITE_USER_PAI_NAME=Nome do Pai

VITE_USER_PROFESSOR_EMAIL=seu_email_prof@dominio.com
VITE_USER_PROFESSOR_PASSWORD=sua_senha_aqui
VITE_USER_PROFESSOR_NAME=Nome do Professor

VITE_USER_DIRECAO_EMAIL=seu_email_direcao@dominio.com
VITE_USER_DIRECAO_PASSWORD=sua_senha_aqui
VITE_USER_DIRECAO_NAME=Nome da Direção

# Endpoint da API REST Online
VITE_REST_API_ENDPOINT=https://api.exemplo.com/v1/users
